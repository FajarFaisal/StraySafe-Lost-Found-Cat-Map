# Copy this file to .env.local and fill in your own values.
# The app runs fine with NONE of these set -- it falls back to demo/mock
# data automatically, so you can develop the UI before the backend exists.

# Supabase (Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Analytics 4 (Admin > Data Streams > your stream > Measurement ID)
VITE_GA_MEASUREMENT_ID=
